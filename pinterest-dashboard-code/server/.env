# Pinterest API credentials
# Get these from https://developers.pinterest.com/apps/
PINTEREST_APP_ID=your_app_id_here
PINTEREST_APP_SECRET=your_app_secret_here

# The URL Pinterest redirects to after login
# Must match EXACTLY what you registered in your Pinterest app settings
PINTEREST_REDIRECT_URI=http://localhost:3001/auth/callback

# Express session secret - use any long random string
SESSION_SECRET=change_this_to_a_random_secret_string

# Port for the Express server
PORT=3001
